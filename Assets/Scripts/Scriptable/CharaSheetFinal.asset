  m_Name: CharaSheetFinal
  m_EditorClassIdentifier: Assembly-CSharp::CharaSheet
  sheets:
  - name: Francko
    visu: {fileID: 6351035654931008261, guid: fdca8e820d7a90b4baffe3fc0aec1a44, type: 3}
    desc: "Pour occuper un peu tout le monde, il organise des petites comp\xE9titions
      sportives. Evidemment, il gagne toujours."
    target: {fileID: 2569630733499183460, guid: a998a1f9fbc3ece42a3857e9f068b4ec, type: 3}
  - name: Fred
    visu: {fileID: -1380451400619836315, guid: 9eccf444d0ba7dd4fba1ec21c2a1a91f, type: 3}
    desc: "C'est pas \xEAtre bloqu\xE9 sur une \xEEle d\xE9serte qui va l'emp\xEAcher
      de montrer \xE0 ses \xE9l\xE8ves comment BIEN dessiner !"
    target: {fileID: 156088777104982390, guid: a675f9926511ad34c86cf1b1b89044cd, type: 3}
  - name: "R\xE9mi"
    visu: {fileID: -7441785129646933766, guid: de24936e3a187d8408de2cfe015ee07d, type: 3}
    desc: "Avec sa cape, il est pr\xE8s \xE0 prendre son envol pour quitter cette
      maudite \xEEle !"
    target: {fileID: 2569630733499183460, guid: 88956e9f897fcda4f93f61f9473f2a83, type: 3}
  - name: Thomas
    visu: {fileID: 5739724147501847755, guid: 16928aeb99d41d94cab5ad75a5d269f4, type: 3}
    desc: "Il en est \xE0 son 10\xE8me karaok\xE9, et il est toujours autant \xE0
      fond."
    target: {fileID: 2569630733499183460, guid: bd1d016a697c5de4b908272650094b48, type: 3}
  - name: "J\xE9r\xF4me"
    visu: {fileID: 6467918230511674243, guid: cf8da14930c1dbf40bf0c7f2e7c457e1, type: 3}
    desc: "Il s'est trouv\xE9 un coin sombre et calma pour continuer \xE0 avancer
      sur son code. Vrai GP, toujours derri\xE8re l'\xE9cran !"
    target: {fileID: 2569630733499183460, guid: 23c168ba04567434caae3d2a2edd9a8f, type: 3}
  - name: Olivier/Catiana
    visu: {fileID: 21300000, guid: e555183820be98744be967f76688d4c5, type: 3}
    desc: "La seule tenue qu'ils leur restaient apr\xE8s le crash est un costume
      de cosmonaute. Au moins, ils sont dans la m\xEAme gal\xE8re."
    target: {fileID: 2569630733499183460, guid: a0bf533be85be494294b1c3aaf270415, type: 3}
  - name: Diana
    visu: {fileID: -3265841040555573645, guid: 12da8c625c16a9c4f93187b26cb196c7, type: 3}
    desc: "Elle est \xE0 son bureau, distribuant des fiches de travail \xE0 tout
      le monde. M\xEAme sur une \xEEle d\xE9serte, au boulot les feignasses !"
    target: {fileID: 2569630733499183460, guid: e9d3c6ae5ca974d4fbf8a986e8e8c9b6, type: 3}
  - name: Alvi
    visu: {fileID: 8795968678727382775, guid: 375e0ad012dab524e853025f819350d1, type: 3}
    desc: "Il fait le d\xE9compte de ce qui peut \xEAtre r\xE9cup\xE9rer dans la
      carcasse de l'avion. Ah, et il a aussi trouv\xE9 un masque \xE0 la Ziak. Il
      se trouve cool avec."
    target: {fileID: 2569630733499183460, guid: 0e9a8726a54601847a37d69c6e863ba7, type: 3}
  - name: Maelle
    visu: {fileID: -5323757731555653822, guid: 3403223b964322f4dad04a5cfa56a682, type: 3}
    desc: Maelle profite du soleil
    target: {fileID: 8250562953841413657, guid: 2e416ce9226a48e43b4826938f3a3b10, type: 3}
